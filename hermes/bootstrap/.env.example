# Hermes — variables d'environnement (profil Docker Compose)
# Copié vers hermes/data/.env au premier démarrage si absent.

# API OpenAI-compatible exposée par le gateway (optionnel — ex. Open WebUI, clients HTTP)
# API_SERVER_ENABLED=false
# API_SERVER_HOST=0.0.0.0
# API_SERVER_PORT=8642
# API_SERVER_KEY=change-me-local-dev

# Messagerie — requis pour le MCP Hermes dans Cursor (lire/envoyer messages)
# 1. Créer un bot via @BotFather sur Telegram → copier le token ci-dessous
# 2. Redémarrer : docker compose -f compose.yaml -f compose.hermes.yml restart hermes-gateway
# 3. Envoyer /start au bot → approuver le pairing (voir docs/hermes-stack.md)
TELEGRAM_BOT_TOKEN=

# DISCORD_BOT_TOKEN=
