MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
# Tokenisation BPE (mode UI « BPE ») : chemin vers le store Ollama (dossier contenant models/blobs/)
# Docker Compose : deja defini dans compose.yaml (ollama_data -> /ollama-models)
# OLLAMA_MODELS_DIR=/ollama-models
# Windows (dev local) : OLLAMA_MODELS_DIR=%USERPROFILE%\.ollama
# Linux (dev local)   : OLLAMA_MODELS_DIR=~/.ollama

# Surcharges par etape (legacy: plan, research, execute, verify)
# Dev teams: write_tests, code, run_fix, document, schematic, test_and_verify
# OLLAMA_MODEL_PLAN=qwen2.5:1.5b
# OLLAMA_MODEL_WRITE_TESTS=qwen2.5-coder:1.5b
# OLLAMA_MODEL_CODE=qwen2.5-coder:1.5b

# Backend (fichier JSON par defaut, MariaDB en Docker)
# CATALOG_BACKEND=file
# ORCHESTRATOR_CATALOG_ROOT=./catalog
# DATABASE_URL=mysql://orchestrateur:orchestrateur@localhost:3306/orchestrateur

# Frontend (dev Vite)
# VITE_API_BASE_URL=http://localhost:8000
# Onglet Parcours : API trace-service (orchestrator-trace, port 8090 par defaut)
# VITE_TRACE_SERVICE_URL=http://127.0.0.1:8090
# Persistance des traces (orchestrateur-trace en local) : fichier SQLite
# TRACE_SQLITE_PATH=./data/traces.sqlite

# Parcours : nombre max de messages d'historique envoyes a Ollama /api/chat
# JOURNEY_MAX_HISTORY_MESSAGES=40

# Serveur MCP (Docker Compose ; point de connexion client MCP)
# MCP_SERVER_PORT=8010
# ORCHESTRATOR_HTTP_TIMEOUT_SECONDS=900
# Comportement strict Accept (voir mcp-server/README.md) :
# MCP_RELAX_ACCEPT_HEADERS=false

# Hermes Agent (overlay compose.hermes.yml — Option A Ollama local)
# Donnees persistees dans ./hermes/data/ (config, sessions, state.db)
# Demarrage : docker compose -f compose.yaml -f compose.hermes.yml up
# Dashboard : http://127.0.0.1:9119 — voir docs/hermes-stack.md

# Workspaces benchmark (dossiers team-tdd / team-classic executables)
# WORKSPACE_ROOT=./workspaces
#
# En Docker : service workspace-runner (pytest isole, meme volume ./workspaces)
#   docker compose exec workspace-runner bash -lc "cd /workspaces/<run>/<team> && pytest -q"
#   ./scripts/workspace-test.ps1 -RunId <run> -Team team-tdd
